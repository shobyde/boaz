{
  "name": "boaz",
  "version": "0.8.1",
  "description": "Declarative capabilities, a knowledge base with rules, and a deterministic answer engine for in-browser assistants: no model download, no API key, every reply traceable to a fact.",
  "type": "module",
  "license": "MIT",
  "author": "sho byde <shobyde@gmail.com>",
  "homepage": "https://github.com/shobyde/boaz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shobyde/boaz.git"
  },
  "keywords": [
    "agent",
    "tool-calling",
    "client-side",
    "in-browser",
    "knowledge-base",
    "datalog",
    "rules",
    "retrieval",
    "deterministic",
    "no-llm",
    "provenance"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "import": "./dist/build/index.js"
    },
    "./probes": {
      "types": "./dist/build/probes.d.ts",
      "import": "./dist/build/probes.js"
    },
    "./package.json": "./package.json",
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.js"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "import": "./dist/rules/index.js"
    },
    "./extract": {
      "types": "./dist/extract/index.d.ts",
      "import": "./dist/extract/index.js"
    }
  },
  "bin": {
    "boaz": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.build.json",
    "prepack": "cp ../../README.md ../../LICENSE ."
  },
  "dependencies": {
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
